@startuml
title Review snapshot references generated by CI
start
:Maintainer adds record-snapshots label;
if (Open PR to main from this repository?) then (yes)
  partition "macOS runner / contents: read" {
    :Check out the event's head SHA without credentials;
    :Require repository write access for the requester;
    :Run all SealbreakAppModuleTests with Point-Free record=all;
    note right
      Xcode 26.6 / iPhone 17 / iOS 26.5.
      Snapshot test helpers must honor SNAPSHOT_TESTING_RECORD.
      New test classes use the same target and reference directory.
      Recording assertions intentionally fail.
    end note
    :Require freshly written PNGs;
    :Restore tracked accessibility text references if present;
    :Remove newly recorded accessibility text references;
    :Run the same tests with record=never;
    if (Verification passes?) then (yes)
      :Upload PNG candidates;
    else (no)
      :Retain XCTest diagnostics; do not publish;
      stop
    endif
  }
  partition "Fresh Ubuntu runner / repository writes" {
    :Require the PR still open at the same head SHA;
    :Check out that SHA and download PNG candidates;
    :git add stages only snapshot PNGs;
    if (Images changed?) then (yes)
      :git commit as github-actions bot;
      :git push normally; reject concurrent branch changes;
      :Request existing CI and dependency checks;
    endif
    :Link images and diagnostics from the PR;
    :Remove label so the next recording needs a new request;
  }
  :Human reviews image changes before merging;
else (no)
  :Skip recording;
endif
stop
@enduml
