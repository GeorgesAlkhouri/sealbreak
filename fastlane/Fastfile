default_platform(:ios)

platform :ios do
  desc "Bump the committed marketing version for a release PR"
  lane :prepare_release do |options|
    release_type = options[:release_type].to_s
    UI.user_error!("release_type must be patch, minor, or major") unless %w[patch minor major].include?(release_type)

    current_version = get_version_number(
      xcodeproj: "Sealbreak.xcodeproj",
      target: "Sealbreak",
      configuration: "Release"
    )

    next_version = increment_version_number(
      bump_type: release_type,
      xcodeproj: "Sealbreak.xcodeproj"
    ).to_s

    updated_version = get_version_number(
      xcodeproj: "Sealbreak.xcodeproj",
      target: "Sealbreak",
      configuration: "Release"
    )
    UI.user_error!("Version bump mismatch: #{updated_version}") unless updated_version == next_version

    if ENV["GITHUB_OUTPUT"]
      File.open(ENV["GITHUB_OUTPUT"], "a") do |output|
        output.puts("current_version=#{current_version}")
        output.puts("next_version=#{next_version}")
      end
    end

    UI.success("Prepared Sealbreak #{current_version} -> #{next_version}")
  end

  desc "Build, sign, and upload Sealbreak to TestFlight"
  lane :testflight do
    setup_ci

    app_identifier = ENV.fetch("APP_IDENTIFIER")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    match_git_url = ENV.fetch("MATCH_GIT_URL")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_BASE64"),
      is_key_content_base64: true
    )

    version = get_version_number(
      xcodeproj: "Sealbreak.xcodeproj",
      target: "Sealbreak",
      configuration: "Release"
    )

    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: app_identifier,
      version: version,
      initial_build_number: 0
    )
    build_number = (latest_build.to_i + 1).to_s

    match(
      type: "appstore",
      app_identifier: app_identifier,
      git_url: match_git_url,
      git_branch: "main",
      team_id: team_id,
      readonly: true
    )

    profile_name = "match AppStore #{app_identifier}"

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Sealbreak.xcodeproj",
      targets: ["Sealbreak"],
      build_configurations: ["Release"],
      team_id: team_id,
      bundle_identifier: app_identifier,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    root = File.expand_path("..", __dir__)
    output_directory = File.join(root, "build/TestFlight")
    ipa_path = File.join(output_directory, "Sealbreak.ipa")
    sbom_path = File.join(output_directory, "sbom.cdx.json")
    # A fixed path lets the SBOM read the package checkouts of this build.
    derived_data_path = File.join(output_directory, "DerivedData")

    UI.message("Preparing Sealbreak #{version} (#{build_number})")

    build_app(
      project: "Sealbreak.xcodeproj",
      scheme: "Sealbreak",
      configuration: "Release",
      destination: "generic/platform=iOS",
      output_directory: output_directory,
      output_name: "Sealbreak.ipa",
      derived_data_path: derived_data_path,
      export_method: "app-store",
      disable_package_automatic_updates: true,
      xcargs: [
        "MARKETING_VERSION=#{version}",
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "COMPILER_INDEX_STORE_ENABLE=NO",
        "-skipMacroValidation"
      ].join(" ")
    )

    ipa_version = get_ipa_info_plist_value(
      ipa: ipa_path,
      key: "CFBundleShortVersionString"
    ).to_s
    ipa_build = get_ipa_info_plist_value(
      ipa: ipa_path,
      key: "CFBundleVersion"
    ).to_s

    UI.user_error!("IPA version mismatch: #{ipa_version}") unless ipa_version == version
    UI.user_error!("IPA build mismatch: #{ipa_build}") unless ipa_build == build_number

    # Without an SBOM the build must not reach TestFlight.
    commit = sh("git", "-C", root, "rev-parse", "HEAD", log: false).strip
    sh(
      "python3", File.join(root, "scripts/ci/sbom.py"),
      "--ipa", ipa_path,
      "--resolved", File.join(root, "Sealbreak.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"),
      "--config", File.join(root, "license_plist.yml"),
      "--checkouts", File.join(derived_data_path, "SourcePackages/checkouts"),
      "--gemfile-lock", File.join(root, "Gemfile.lock"),
      "--version", version,
      "--build-number", build_number,
      "--commit", commit,
      "--repository", "#{ENV.fetch('GITHUB_SERVER_URL')}/#{ENV.fetch('GITHUB_REPOSITORY')}",
      "--xcode-version", sh("xcodebuild", "-version", log: false).lines.first.split.last,
      "--output", sbom_path
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: app_identifier,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )

    if ENV["GITHUB_OUTPUT"]
      File.open(ENV["GITHUB_OUTPUT"], "a") do |output|
        output.puts("version=#{version}")
        output.puts("build_number=#{build_number}")
        output.puts("commit=#{commit}")
        output.puts("ipa_path=#{ipa_path}")
        output.puts("sbom_path=#{sbom_path}")
      end
    end

    UI.success("Uploaded Sealbreak #{ipa_version} (#{ipa_build}) to TestFlight")
  end
end
