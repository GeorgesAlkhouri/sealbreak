default_platform(:ios)

platform :ios do
  desc "Create an unsigned iOS release archive"
  lane :archive do |options|
    release_type = options[:release_type].to_s

    unless %w[patch minor major].include?(release_type)
      UI.user_error!("release_type must be patch, minor, or major")
    end

    version = increment_version_number(
      bump_type: release_type,
      xcodeproj: "Sealbreak.xcodeproj"
    )

    build_number = ENV.fetch("GITHUB_RUN_NUMBER")

    increment_build_number(
      build_number: build_number,
      xcodeproj: "Sealbreak.xcodeproj"
    )

    UI.message("Preparing Sealbreak #{version} (#{build_number})")

    build_app(
      project: "Sealbreak.xcodeproj",
      scheme: "Sealbreak",
      configuration: "Release",
      destination: "generic/platform=iOS",
      archive_path: "build/Release/Sealbreak.xcarchive",
      skip_codesigning: true,
      skip_package_ipa: true,
      disable_package_automatic_updates: true,
      xcargs: "COMPILER_INDEX_STORE_ENABLE=NO -skipMacroValidation"
    )
  end
end
