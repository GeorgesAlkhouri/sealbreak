{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-3 * * *"
  ],
  "prConcurrentLimit": 3,
  "automerge": false,
  "platformAutomerge": false,
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Wait 7 days before updating dependencies with reliable release timestamps",
      "matchDatasources": [
        "github-tags",
        "github-releases",
        "github-digest",
        "pypi"
      ],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Group non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group non-major pre-commit hook updates",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Automerge stable minor and patch updates after CI passes",
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Require explicit approval for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep the CI Python runtime on the 3.13 release line",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.13(?:\\.|$)/"
    },
    {
      "description": "Track current OpenBao and Vault releases without the global release delay",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "openbao/openbao",
        "hashicorp/vault"
      ],
      "minimumReleaseAge": "0 days",
      "dependencyDashboardApproval": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/ci\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: packageName=(?<packageName>[^\\s]+)\\s+version:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "{{{packageName}}}",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    }
  ]
}
