{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>georgesalkhouri/renovate-config",
    "github>georgesalkhouri/renovate-config:python(3.13)"
  ],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Group non-major pre-commit hook updates",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Review LicensePlist updates by hand: the downloaded binary runs in the iOS CI job, which can request OIDC tokens",
      "matchDepNames": [
        "mono0926/LicensePlist"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/integration\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: packageName=(?<packageName>[^\\s]+)\\s+version:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "{{{packageName}}}",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/ci\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: depName=(?<depName>mono0926/LicensePlist)\\s+LICENSEPLIST_VERSION:\\s*\"(?<currentValue>[^\"]+)\"\\s+LICENSEPLIST_SHA256:\\s*(?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "versioningTemplate": "semver"
    }
  ]
}
